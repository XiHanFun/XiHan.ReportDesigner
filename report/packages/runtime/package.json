{
  "name": "@xihan-report/runtime",
  "type": "module",
  "version": "0.0.0",
  "description": "XiHan Report Designer runtime — Web Components for viewing reports and dashboards.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://github.com/XiHanFun/XiHan.ReportDesigner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.ReportDesigner.git",
    "directory": "report/packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.ReportDesigner/issues"
  },
  "keywords": [
    "report",
    "report-designer",
    "dashboard",
    "web-components",
    "xihanfun"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx.d.ts",
      "import": "./dist/xlsx.js"
    },
    "./style.css": "./style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "style.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@xihan-report/core": "workspace:^",
    "@xihan-ui/core": "catalog:",
    "@xihan-ui/designer-kit": "catalog:",
    "@xihan-ui/expression": "catalog:",
    "@xihan-ui/viz": "catalog:",
    "@xihan-ui/web-components": "catalog:",
    "@xihan-ui/xlsx": "catalog:"
  },
  "devDependencies": {
    "jsdom": "catalog:"
  }
}
